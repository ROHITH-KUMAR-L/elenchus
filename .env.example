# Copy to .env and fill in real values. .env is gitignored; never commit secrets.
# Load it yourself before running (e.g. `set -a; . ./.env; set +a`); the tool
# reads these from the process environment.

# --- Operational (already read by the tool) ---
# ZAP daemon API key (from the running container; never commit it).
ZAP_API_KEY=
# ZAP API base, loopback only.
ZAP_API_URL=http://127.0.0.1:8090
# Target base URL, alternative to --base-url. Localhost only.
ELENCHUS_BASE_URL=http://127.0.0.1:9090/VulnerableApp

# --- AI (BS10i/BS10j, OpenAI-compatible endpoint; all AI is off by default) ---
# Any OpenAI-compatible server (OpenAI, Groq, Azure, Together, vLLM, Ollama, ...).
# Variables are read in order: OPENAI_*, then GROQ_*, then generic LLM_*.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Groq example (uncomment and fill):
# GROQ_API_KEY=gsk_...
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile


POSTGRES_DB=<existing database name>
POSTGRES_USER=<existing database user>
POSTGRES_PASSWORD=<existing database password>
POSTGRES_HOST_PORT=5432