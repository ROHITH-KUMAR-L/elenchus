# Copy to .env and fill in real values. .env is gitignored; never commit secrets.
# The `elenchus` command loads a .env in the working directory automatically; a
# variable already set in the real environment always wins over the file.

# --- Operational (already read by the tool) ---
# ZAP daemon API key (from the running container; never commit it).
ZAP_API_KEY=
# ZAP API base, loopback only.
ZAP_API_URL=http://127.0.0.1:8090
# Target base URL, alternative to --base-url. Localhost only.
ELENCHUS_BASE_URL=http://127.0.0.1:9090/VulnerableApp

# --- AI (BS10i/BS10j, OpenAI-compatible; all AI is off by default) ---
# Set ONE provider's API key. Resolution order: Groq, then OpenRouter, then
# NVIDIA NIM, then generic LLM_*. Only the key is required; base URL and model
# fall back to the working free defaults shown. Override a model with <PREFIX>_MODEL.
#
# Groq (primary):
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile          # base: https://api.groq.com/openai/v1
#
# OpenRouter (fallback):
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free   # base: https://openrouter.ai/api/v1
#
# NVIDIA NIM (fallback):
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct    # base: https://integrate.api.nvidia.com/v1
#
# Any other OpenAI-compatible endpoint (generic, last resort):
# LLM_API_KEY=...
# LLM_BASE_URL=https://.../v1
# LLM_MODEL=...


POSTGRES_DB=<existing database name>
POSTGRES_USER=<existing database user>
POSTGRES_PASSWORD=<existing database password>
POSTGRES_HOST_PORT=5432